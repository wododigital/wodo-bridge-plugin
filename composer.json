{
    "name": "wodo/bridge",
    "description": "WODO Bridge v2 — scope-gated REST surface for WordPress, paired with the WODO Bridge aggregator.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "WODO_Bridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WODO_Bridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:rest": "phpunit --testsuite=rest",
        "test:security": "phpunit --testsuite=security"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
